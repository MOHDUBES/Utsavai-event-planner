# ─────────────────────────────────────────────────────────────
# UtsavAI – Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── AI Provider ──────────────────────────────────────────────
# Supported: gemini | openai | anthropic | none (offline fallback)
AI_PROVIDER=gemini

# Gemini API key (get from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model ID (e.g. gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API key (optional alternative)
# OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API key (optional alternative)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Server ───────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
DEBUG=false

# Allowed frontend origins (comma-separated)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ── Rate Limiting ─────────────────────────────────────────────
# Max requests per minute per IP
RATE_LIMIT_RPM=30

# ── LLM Cache ─────────────────────────────────────────────────
# Max LRU cache entries for LLM responses
LLM_CACHE_SIZE=128

# LLM request timeout in seconds
LLM_TIMEOUT_SECONDS=30
